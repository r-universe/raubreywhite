	path = .registry
	url = https://github.com/raubreywhite/raubreywhite.r-universe.dev
	branch = HEAD
[submodule "cohort"]
	path = cohort
	url = https://github.com/raubreywhite/cohort
[submodule "org"]
	path = org
	url = https://github.com/raubreywhite/org
[submodule "plnr"]
	path = plnr
	url = https://github.com/raubreywhite/plnr
